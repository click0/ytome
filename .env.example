# YouTube Data API v3 key
# Получить: https://console.cloud.google.com → Enable YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Путь к хранилищу файлов
# Windows: C:\Users\YourName\youtube-archive\storage
# Linux/Mac: /home/yourname/youtube-archive/storage
STORAGE_PATH=./storage

# Путь к SQLite базе данных
DB_PATH=./storage/archive.db

# Транспорт MCP: "stdio" (локально) или "http" (сервер)
MCP_TRANSPORT=stdio

# Порт HTTP-сервера (только если MCP_TRANSPORT=http)
MCP_PORT=3000

# Интервал проверки новых видео (cron формат)
# По умолчанию: каждые 2 часа
CHECK_INTERVAL=0 */2 * * *

# Максимум видео на канал при первой синхронизации
INITIAL_FETCH_LIMIT=50

# Скачивать thumbnails автоматически (true/false)
AUTO_DOWNLOAD_THUMBNAILS=true

# ─── ПРОКСІ ────────────────────────────────────────
# Режим: disabled | single | rotation | fallback
# Можна змінити через MCP-інструмент proxy_set_mode
PROXY_MODE=disabled

# Проксі додаються через MCP: proxy_add
# Приклади URL:
#   http://host:port
#   http://user:password@host:port
#   socks5://host:1080
#   socks5://user:password@host:1080

# Шлях до yt-dlp (якщо не в PATH)
# Windows: YTDLP_BIN=C:\\Tools\\yt-dlp.exe
YTDLP_BIN=yt-dlp

# ─── AI ПРОВАЙДЕРИ ────────────────────────────────
# Режим балансера: priority | cost | roundrobin
#
#   priority   — фіксований пріоритет за складністю задачі
#   cost       — автоматично вибирає найдешевший провайдер (рекомендовано)
#   roundrobin — рівномірно розподіляє запити між всіма активними
#
BALANCER_MODE=cost

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Моделі за рівнями (порожньо = поточні за замовчуванням):
#   fast     — прості задачі        (claude-haiku-5-5,  $0.10 / $0.50 за 1M токенів)
#   balanced — середні             (claude-sonnet-5-5, $2 / $10)
#   top      — складні / критичні   (claude-opus-5-5,   $4 / $20; найсильніша — claude-fable-5-1, $10 / $50)
# Відмову класифікатора безпеки Opus / Sonnet / Fable автоматично перехоплює інша модель Anthropic.
CLAUDE_MODEL_FAST=
CLAUDE_MODEL_BALANCED=
CLAUDE_MODEL_TOP=

# Ollama — локально, безкоштовно (https://ollama.ai)
# Запуск: ollama serve && ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ENABLED=true

# Groq — хмара, безкоштовний tier (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter — 100+ моделей, є безкоштовні (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# LM Studio — локально (https://lmstudio.ai)
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_MODEL=local-model
LMSTUDIO_ENABLED=false

# ─── MCP HTTP СЕРВЕР ───────────────────────────────
MCP_HTTP_PORT=3000
# MCP_HOST=0.0.0.0       # розкоментувати для LAN доступу
# MCP_API_KEY=my-secret  # токен для захисту endpoint

# ─── AI PROXY URL (зовнішній роутер) ───────────────
# Якщо встановлено — всі AI запити йдуть через цей URL.
# Внутрішній балансер використовується як fallback.
#
# claude-code-router:  AI_PROXY_URL=http://localhost:3456
# olla:                AI_PROXY_URL=http://localhost:40114/olla/openai
# OmniRoute/NadirClaw: AI_PROXY_URL=http://localhost:8402
# Ollama на LAN ПК:    AI_PROXY_URL=http://192.168.1.50:11434
# Self-hosted VPS:     AI_PROXY_URL=https://ai.myserver.com
#
# OpenAI напряму:     AI_PROXY_URL=https://api.openai.com  + AI_PROXY_API_KEY=sk-...  + AI_PROXY_MODEL=gpt-4o-mini
#
AI_PROXY_URL=
AI_PROXY_API_KEY=     # Bearer token якщо роутер вимагає авторизацію
AI_PROXY_MODEL=       # Модель для проксі (порожньо = auto; для OpenAI — обов'язково)

# ─── GOOGLE SERVICE ACCOUNT (Drive + Sheets) ───────
# 1. console.cloud.google.com → IAM → Service Accounts → Create
# 2. Завантаж JSON-ключ, вкажи шлях нижче
# 3. Розшарь папку Drive / таблиці на email сервіс-акаунта
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Drive folder ID з URL: https://drive.google.com/drive/folders/XXXXX
GOOGLE_DRIVE_FOLDER_ID=

# Email на який автоматично шарити створені Sheets (опційно)
GOOGLE_SHEETS_SHARE_WITH=

# ─── ВИЯВЛЕННЯ НОВИХ ВІДЕО ─────────────────────────
# RSS-фіди каналів: ~1 од. квоти на канал замість 100 (search.list).
# Перша синхронізація каналу все одно йде через search.list (глибший бекфіл).
RSS_DETECTION=true

# ─── ЗАВАНТАЖЕННЯ (yt-dlp) ─────────────────────────
# Таймаут одного завантаження, хвилин (з ретраями великі файли качаються довше)
YTDLP_TIMEOUT_MIN=30

# ─── МЕДІАБІБЛІОТЕКА (Jellyfin / Emby / Plex) ──────
# Куди library_export складає структуру "Канал/Season РРРР" з .nfo.
# Має бути окремою текою: не корінь storage і не всередині storage/media.
MEDIA_LIBRARY_PATH=./storage/library

# Якщо хардлінк неможливий (бібліотека на іншій ФС / іншому датасеті ZFS):
#   auto — клон блоків (reflink), інакше symlink. Місце не витрачається ніколи.
#   copy — клон блоків, інакше звичайна копія (copy_file_range). На OpenZFS 2.2+
#          з block cloning це клон навіть між датасетами одного пулу, інакше —
#          повна копія. Для Jellyfin у Docker, де symlink поза контейнер битий.
LIBRARY_LINK_MODE=auto

# ─── AI-ПІДСУМКИ ТРАНСКРИПТІВ ──────────────────────
# Автопідсумки нових відео з каналів, позначених summary_auto (після кожної синхронізації)
AUTO_SUMMARY=true
# Мова підсумків (uk, en, ru, pl, de…) — незалежно від мови відео
SUMMARY_LANGUAGE=uk
# Скільки підсумків на день максимум (обмежує витрати на AI)
SUMMARY_DAILY_LIMIT=50
# Коротші відео не підсумовуються (shorts — ніколи)
SUMMARY_MIN_DURATION_SEC=180
# Складність для балансувальника: simple | medium | complex
SUMMARY_COMPLEXITY=medium
# Розмір частини транскрипту для map-reduce (символів); менше — для малих локальних моделей
SUMMARY_CHUNK_CHARS=6000
