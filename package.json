{
  "name": "ytome",
  "version": "0.90.0",
  "description": "Independent YouTube archive & MCP server for Claude",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/mcp/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/mcp/index.js",
    "start:local": "node dist/mcp/index.js",
    "start:server": "node dist/mcp/server-http.js",
    "db:init": "node dist/db/init.js",
    "scheduler": "node dist/scheduler/index.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:version": "node scripts/check-version.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^173.0.0",
    "https-proxy-agent": "^9.1.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socks-proxy-agent": "^10.1.0",
    "youtube-transcript-plus": "^2.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/node-cron": "^3.0.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
