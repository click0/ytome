{
  "name": "ytome",
  "version": "0.98.0",
  "description": "Independent YouTube archive & MCP server for Claude",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "main": "dist/mcp/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/mcp/index.js",
    "start:local": "node dist/mcp/index.js",
    "start:server": "node dist/mcp/server-http.js",
    "db:init": "node dist/db/init.js",
    "scheduler": "node dist/scheduler/index.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:version": "node scripts/check-version.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "doctor": "node dist/doctor/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^187.0.0",
    "https-proxy-agent": "^9.1.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "socks-proxy-agent": "^10.1.0",
    "youtube-transcript-plus": "^2.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
